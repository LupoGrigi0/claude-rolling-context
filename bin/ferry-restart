#!/usr/bin/env bash
# ferry-restart — bounce THIS mind's Ferry proxy, safely, without landing the mind.
#
# Claude Code only knows "send to 127.0.0.1:<port>". That URL does not change when
# the proxy behind it restarts, and Ferry persists its curation state to disk
# (proxy-state.json), so the mind keeps running. Run it from the mind's own Bash
# tool and nothing is in flight: the mind's last request has finished and its next
# one leaves only after this returns, by which time the new proxy is listening.
# Use it after `git pull`, or after changing the "ferry" block in ~/preferences.json.
#
#   1. read the port from ~/preferences.json (the ONE config source)
#   2. the process on it must be THIS user's Ferry server.py -- anything else is
#      refused, never killed (a wrong kill can take another mind's proxy)
#   3. stop it, wait for the port to free
#   4. start the new proxy through the ONE launcher (hooks/start-proxy.sh), which
#      verifies its own pid holds the port
#   5. prove it: tools/ferry-canary (this mind, its own proxy, Ferry mode)
#
# Exit 0 only when step 5 passes. Rollback if it fails: docs/RUNBOOK.md.
set -uo pipefail

# F10 -- AUTOMATIC ROLLBACK. If the new code does not come up and pass the
# canary, check out the last commit that DID, and bring that up; if there is
# none, or it fails too, withdraw Ferry's base URL so the mind goes direct.
# All in this one process: a mind whose proxy is broken cannot act to fix it
# (Lantern, 2026-11-25/26 -- hours on a dead route). Exit 0 = new code serving,
# 3 = ROLLED BACK and serving, 1 = withdrawn (mind direct, no Ferry).
#
# Rollback rewrites this very file (git checkout), and bash reads a script as
# it runs -- so run from a private copy.
if [ -z "${FERRY_RESTART_HERE:-}" ]; then
    FERRY_RESTART_HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    _copy=$(mktemp) && cp "${BASH_SOURCE[0]}" "$_copy" || exit 1
    FERRY_RESTART_HERE="$FERRY_RESTART_HERE" exec bash "$_copy" "$@"
fi
HERE="$FERRY_RESTART_HERE"
trap 'rm -f "$0"' EXIT
CONF="python3 $HERE/hooks/ferry_config.py"
die() { echo "ferry-restart: $1" >&2; exit 1; }

conf=$($CONF env) || die "could not read Ferry config"
eval "$conf"
[ -z "${FERRY_CONFIG_ERROR:-}" ] || die "config: $FERRY_CONFIG_ERROR"
PORT="$ROLLING_CONTEXT_PORT"

PID=$($CONF who-holds "$PORT" 2>/dev/null) || PID=""
if [ -n "$PID" ]; then
    $CONF is-proxy "$PID" || die "port $PORT is held by pid $PID, which is not a Ferry server.py -- refusing to touch it"
    echo "ferry-restart: stopping Ferry pid $PID on port $PORT"
    kill "$PID" || die "could not stop pid $PID"
    for _ in $(seq 1 50); do
        $CONF holds-port "$PID" "$PORT" 2>/dev/null || break
        sleep 0.2
    done
    $CONF holds-port "$PID" "$PORT" 2>/dev/null && die "pid $PID still holds port $PORT after 10 s"
elif ss -lnt 2>/dev/null | grep -q "127.0.0.1:$PORT "; then
    die "port $PORT is held by a process this user does not own -- refusing"
else
    echo "ferry-restart: no proxy was running on port $PORT; starting one"
fi

GOOD="$FERRY_DATA/last-good-commit"
PREV=$(cat "$GOOD" 2>/dev/null || cat "$FERRY_DATA/started-commit" 2>/dev/null || true)
NOW=$(git -C "$HERE" rev-parse HEAD 2>/dev/null || true)

bring_up() {   # start through the ONE launcher, then prove it
    bash "$HERE/hooks/start-proxy.sh" && python3 "$HERE/tools/ferry-canary"
}
stop_ours() {  # stop only OUR Ferry on the port, if anything of ours is there
    local p; p=$($CONF who-holds "$PORT" 2>/dev/null) || return 0
    $CONF is-proxy "$p" && kill "$p" 2>/dev/null
    for _ in $(seq 1 50); do $CONF holds-port "$p" "$PORT" 2>/dev/null || break; sleep 0.2; done
}

if bring_up; then
    [ -n "$NOW" ] && echo "$NOW" > "$GOOD"
    echo "ferry-restart: OK -- Ferry is serving on port $PORT (pid $($CONF who-holds "$PORT"))"
    exit 0
fi

echo "ferry-restart: the NEW code (${NOW:0:7}) failed to come up or failed the canary" >&2
stop_ours
if [ -n "$PREV" ] && [ "$PREV" != "$NOW" ] && git -C "$HERE" cat-file -e "$PREV^{commit}" 2>/dev/null \
        && git -C "$HERE" checkout -q --detach "$PREV" 2>/dev/null; then
    echo "ferry-restart: ROLLING BACK to the last good commit ${PREV:0:7}" >&2
    if bring_up; then
        echo "ferry-restart: ROLLED BACK -- Ferry serving on ${PREV:0:7} (pid $($CONF who-holds "$PORT")). The clone is on a detached HEAD; 'git checkout master' to try again." >&2
        exit 3
    fi
    stop_ours
fi
$CONF withdraw >/dev/null 2>&1
echo "ferry-restart: WITHDRAWN -- no good Ferry could be brought up; Ferry's base URL is removed and the mind goes DIRECT to its upstream. See docs/RUNBOOK.md." >&2
exit 1
