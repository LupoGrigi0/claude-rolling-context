# Ferry context proxy for ONE mind, supervised (ship item S5). Instance = the
# mind's unix user, exact case per `id`:
#   systemctl enable --now hacs-ferry@Crossing-2d23
# DRAFT -- root installs it; see deploy/README.md. Modelled on hacs-doorbell@.
#
# Config is NOT in this file. It comes from ~USER/preferences.json "ferry" via
# hooks/ferry_config.py -- the same resolver the SessionStart hook and install.sh
# use -- so there is one declared source. That block must say "supervised": true,
# or the hook will ALSO start a proxy and the two will fight for the port.
[Unit]
Description=Ferry context proxy for %i
After=network-online.target
Wants=network-online.target
# Never give up: a canary that fails because the API is briefly down must not
# leave the mind with NO proxy once the API comes back.
StartLimitIntervalSec=0

[Service]
User=%i
WorkingDirectory=~
# THE PINNED CHECKOUT -- the one place the code path is named. A release copy
# root owns, NEVER a working tree a mind edits: a `git checkout` there changes
# what the proxy loads on its next restart, silently. Do not set it elsewhere.
Environment=FERRY_HOME=/usr/local/lib/ferry
Environment=FERRY_SUPERVISED=1
# Optional per-mind overrides, root-owned (e.g. CLAUDE_CONFIG_DIR if the mind
# uses one -- upstream resolution reads that settings.json). Env beats
# preferences.json, so keep it short.
EnvironmentFile=-/etc/ferry/%i.env
ExecStart=/bin/sh -c 'conf=$$(/usr/bin/python3 "$$FERRY_HOME/hooks/ferry_config.py" env) || exit 1; eval "$$conf"; if [ -n "$$FERRY_CONFIG_ERROR" ]; then echo "ferry config: $$FERRY_CONFIG_ERROR" >&2; exit 1; fi; cd "$$FERRY_HOME/proxy" && exec /usr/bin/python3 server.py'
# Proof, not a green unit: this mind's proxy, curating, forwarding. Non-zero
# fails the start, and Restart= tries again.
# --pid: the port must be held by THIS unit's process, not a hook-launched
# proxy of the same mind still running from somewhere else.
ExecStartPost=/usr/bin/python3 ${FERRY_HOME}/tools/ferry-canary --wait 30 --pid ${MAINPID}
Restart=on-failure
RestartSec=10
# Everything the proxy logs is in its rotating debug log (docs/RUNBOOK.md);
# stdout would duplicate it into the journal at DEBUG. Tracebacks still land.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
