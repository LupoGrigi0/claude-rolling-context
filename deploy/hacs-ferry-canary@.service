# Ferry canary for ONE mind, on a timer (ship item S7). ExecStartPost on
# hacs-ferry@ only proves the START; the thrash lockout lives in memory and
# appears later. A failed run shows in `systemctl --failed`.
[Unit]
Description=Ferry canary for %i

[Service]
Type=oneshot
User=%i
# Keep the same as hacs-ferry@.service's FERRY_HOME.
Environment=FERRY_HOME=/usr/local/lib/ferry
EnvironmentFile=-/etc/ferry/%i.env
ExecStart=/usr/bin/python3 ${FERRY_HOME}/tools/ferry-canary
